# 把本文件复制成 .env，填下面 3 个 LLM_* 即可。任意 OpenAI 兼容端点都能跑
# （DeepSeek / OpenAI / Claude / 百炼·通义千问 / 智谱GLM / 豆包 / Kimi / 本地 Ollama …）。
# GUI 里有「常用快捷」下拉，选了会自动填好 base_url + model，多数人只需粘一个 key。
#
# Copy to .env and fill the three LLM_* vars. Any OpenAI-compatible endpoint works.

# ─── LLM 端点（必填 base_url 之外的两项 / required）─────────────────────────

# API key（必填）。各家申请地址：
#   DeepSeek  https://platform.deepseek.com/api_keys
#   OpenAI    https://platform.openai.com/api-keys
#   Claude    https://console.anthropic.com/settings/keys
#   通义/百炼  https://bailian.console.aliyun.com/
#   智谱GLM    https://open.bigmodel.cn/usercenter/apikeys
#   豆包/方舟  https://console.volcengine.com/ark
LLM_API_KEY=

# 端点 base_url。留空 = OpenAI 默认端点。常见值：
#   DeepSeek  https://api.deepseek.com
#   通义/百炼  https://dashscope.aliyuncs.com/compatible-mode/v1
#   智谱GLM    https://open.bigmodel.cn/api/paas/v4
#   豆包/方舟  https://ark.cn-beijing.volces.com/api/v3
#   本地Ollama http://localhost:11434/v1
LLM_BASE_URL=https://api.deepseek.com

# 模型名（必填）。示例使用当前已验证的 DeepSeek 模型，也可换成其他兼容模型。
LLM_MODEL=deepseek-v4-flash

# ─── 求职信息 / Job details ────────────────────────────────────────────────

# 要选的岗位 tag，比如 "后端开发（成都）"。留空 → 用 BOSS 的默认推荐 feed
# The job category tag, e.g. "Backend Engineer (Shanghai)". Empty = default recommended feed
BOSS_LABEL=

# 简历 PDF 路径，留空 → 默认 ./resume/my_cover.pdf
# Resume PDF path. Empty = default ./resume/my_cover.pdf
RESUME_PATH=

# ─── 行为开关 / Behavior toggles ─────────────────────────────────────────────

# DRY_RUN=1 时只进行岗位匹配与评分，不点击“立即沟通”
# DRY_RUN=1 scores job fit without clicking Contact
# DRY_RUN=1

# 单独存放 Chrome profile 的目录。第一次扫码登录后 cookie 会留在这里，
# 之后跑都跳过扫码。默认 ./chrome_profile
# Directory holding the dedicated Chrome profile. Persisted login cookies live
# here; subsequent runs skip the QR scan. Default ./chrome_profile
# BOSS_CHROME_PROFILE=

# 语义模型加载顺序：系统 Hugging Face 缓存 → 此项目缓存目录；两边都没有时，
# 首次下载到此目录。默认 ./model_cache，GUI 会显示绝对路径。该目录已被 Git
# 忽略，不会提交约 438 MB 的模型权重。
# Model lookup order: system Hugging Face cache, then this project cache. If
# absent from both, the first download goes here. Default: ./model_cache.
# BOSS_MODEL_CACHE_DIR=

# Chrome sandbox 起不来时的兜底开关（仅排障场景使用）。
# root 用户下 nodriver 已经会自动关闭 sandbox，不用设这个；本变量是给非 root
# 但 sandbox 仍然失败的场景（例如某些容器）用的。
# Escape hatch for when Chrome's sandbox fails to start (troubleshooting only).
# Under root, nodriver already disables the sandbox automatically — you don't
# need this. Use it for non-root environments (e.g. some containers) where the
# sandbox still fails.
# BOSS_NO_SANDBOX=1

# 职位匹配过滤的 LLM 评分阈值（0-100），低于该分的职位跳过不投。默认 50
# Minimum LLM match score (0-100) for the job filter; lower-scored jobs are skipped. Default 50
# BOSS_MIN_MATCH_SCORE=50

# 关键词粗筛门槛：JD 至少命中几个简历关键词才进 LLM 评分。默认 2，跳过太多就调低到 1
# Keyword pre-filter threshold: min resume keywords a JD must hit before LLM scoring. Default 2
# BOSS_MIN_KEYWORD_MATCH=2

# 黑名单关键字，包含这些词的岗位将被直接跳过（逗号分隔，如 "外包,驻场"）
# Keywords to exclude jobs (comma-separated, e.g., "outsourcing,internship")
# BOSS_EXCLUDE_KEYWORDS=外包,驻场,外派,实习,培训

# JSONL 审计日志路径，默认 ./logs/letters.jsonl
# LETTER_LOG_PATH=./logs/letters.jsonl

# 仅记录“已确认发送成功”的岗位，UTF-8 BOM CSV，可直接用中文 Excel 打开。
# 默认 ./logs/applications.csv；字段包含公司、职位、完整 JD、匹配分数和实际招呼语等。
# BOSS_APPLICATION_CSV_PATH=./logs/applications.csv

# 正式模式单次最多成功发送多少条；跳过/失败不计数。建议先从 2~3 条小批量开始。
# BOSS_AUTO_SEND_MAX_SENT=3
# 每次成功发送并关闭“留在此页继续沟通”弹窗后，随机等待再处理下一岗位。
# BOSS_AUTO_SEND_DELAY_MIN=10
# BOSS_AUTO_SEND_DELAY_MAX=60

# 桌面 App 界面语言（zh / en）。一般在 GUI「配置」页切换、自动写入这里；
# 不填则首次启动跟随系统语言。
# Desktop app UI language (zh / en). Usually toggled on the GUI Config page and
# written here automatically; if unset, the first launch follows the system locale.
# BOSS_LANG=zh
